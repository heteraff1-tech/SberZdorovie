{
  "name": "daybeat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests docs README.md vite.config.js playwright.config.js package.json",
    "format:check": "prettier --check src tests docs README.md vite.config.js playwright.config.js package.json"
  },
  "dependencies": {
    "vue": "3.5.30"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-vue": "6.0.4",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "vite": "7.3.1"
  }
}
